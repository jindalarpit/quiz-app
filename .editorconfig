# EditorConfig helps maintain consistent coding styles across IDEs
# https://editorconfig.org

root = true

# Default for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Java files (Google Java Format AOSP style)
[*.java]
indent_size = 4

# XML/POM files
[*.xml]
indent_size = 4

# Markdown files (trailing spaces are significant)
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_size = 2

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Makefile (requires tabs)
[Makefile]
indent_style = tab
